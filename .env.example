# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Operational Mode
# stub   = All endpoints return canonical mock data (Day 0 / Day 1)
# hybrid = Configured domains hit real upstreams; unconfigured domains return stubs
# live   = All endpoints route to live upstreams
BFF_MODE=stub

# Latency Simulation (ms) for testing client-side spinners and loading skeletons
SIMULATED_LATENCY_MS=0

# Security & CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:4200,http://localhost:4207,http://localhost:8080

# Upstream Backend APIs (hydrated as legacy endpoints are audited)
UPSTREAM_MAIN_API_URL=http://main-api.internal
UPSTREAM_SECURE_API_URL=http://secure-api.internal
UPSTREAM_PICKER1_API_URL=http://picker1-api.internal
UPSTREAM_PICKER2_API_URL=http://picker2-api.internal
